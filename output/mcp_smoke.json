      "arguments": {
        "sku": "CC-HOOD-NAVY",
        "size": "M"
      },
      "output": {
        "sku": "CC-HOOD-NAVY",
        "rows": [
          {
            "sku": "CC-HOOD-NAVY",
            "name": "Basic Hoodie Big Yale",
            "size": "M",
            "qty": 8,
            "location": "Aisle A"
          }
        ],
        "total_qty": 8
      },
      "db_check": {
        "sql": "SELECT qty, location FROM inventory WHERE sku='CC-HOOD-NAVY' AND size='M'",
